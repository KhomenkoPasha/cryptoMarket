<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/market_overview_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_card_surface"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="14dp"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/market_fear_greed_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/market_fear_greed"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_size_micro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/market_fear_greed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_size_display"
                android:textStyle="bold"
                tools:text="72" />

            <TextView
                android:id="@+id/market_fear_greed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_size_body"
                tools:text="Greed" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/market_fear_greed_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:trackColor="@color/outline_variant"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="72" />

        <TextView
            android:id="@+id/market_fear_greed_yesterday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_size_micro"
            tools:text="Yesterday 68" />
    </LinearLayout>

    <View
        android:id="@+id/market_overview_divider"
        android:layout_width="0.7dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@color/outline_variant" />

    <LinearLayout
        android:id="@+id/market_global_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/market_btc_dominance"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_size_micro" />

        <TextView
            android:id="@+id/market_btc_dominance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold"
            tools:text="54.3%" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/market_btc_dominance_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:indicatorColor="@color/brand_primary"
            app:trackColor="@color/outline_variant"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            tools:progress="54" />

        <TextView
            android:id="@+id/market_total_cap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/text_size_micro"
            tools:text="Market cap $2.1T  +1.2%" />
    </LinearLayout>
</LinearLayout>
