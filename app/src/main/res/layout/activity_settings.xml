<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_depth"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:minHeight="48dp"
            android:theme="@style/ToolbarColoredBackArrow"
            app:titleTextAppearance="@style/TextAppearance.Crypto.Toolbar"
            app:titleTextColor="@color/on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/language_layout"
                layout="@layout/settings_row" />

            <include
                android:id="@+id/theme_row"
                layout="@layout/settings_row" />

            <include
                android:id="@+id/wallpaper_row"
                layout="@layout/settings_row" />

            <include
                android:id="@+id/currency_row"
                layout="@layout/settings_row" />

            <include
                android:id="@+id/alerts_row"
                layout="@layout/settings_row" />

            <include
                android:id="@+id/lock_row"
                layout="@layout/settings_row" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
