<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/portfolio_switcher_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/portfolio_switcher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true" />

    </HorizontalScrollView>


    <LinearLayout
        android:id="@+id/holdings_summary_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_hero_card"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/portfolio_tracker"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_current_value"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/holdings_summary_current_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_light"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_invested"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/holdings_summary_invested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_light"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_total_pnl"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/holdings_summary_total_pnl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_light"
                    android:textSize="@dimen/text_size_body_large" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_day_pnl"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/holdings_summary_day_pnl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey_light"
                    android:textSize="@dimen/text_size_body_large" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/holdings_summary_extra"
            layout="@layout/portfolio_summary_extra" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/portfolio_history_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_surface"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/portfolio_value_history"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/portfolio_history_periods"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/portfolio_history_1m"
                    style="@style/Widget.Crypto.Button.Toggle"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_1m" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/portfolio_history_3m"
                    style="@style/Widget.Crypto.Button.Toggle"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_3m" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/portfolio_history_1y"
                    style="@style/Widget.Crypto.Button.Toggle"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_1y" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/portfolio_history_all"
                    style="@style/Widget.Crypto.Button.Toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:text="@string/chart_period_all" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <TextView
            android:id="@+id/portfolio_history_change"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            tools:text="+8.40%  3M"
            tools:textColor="@color/positive" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="4dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/portfolio_history_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/portfolio_history_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_size_body"
                android:visibility="gone"
                tools:text="Building history…"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/portfolio_history_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_max_drawdown"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/portfolio_history_drawdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    tools:text="-12.30%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_best_day"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/portfolio_history_best"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    tools:text="+4.10%  Sep 3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/portfolio_worst_day"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/portfolio_history_worst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_surface"
                    android:textStyle="bold"
                    tools:text="-6.20%  Sep 9" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/holdings_empty_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/glass_surface_start"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/glass_outline"
        app:strokeWidth="@dimen/stroke_hairline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/portfolio_empty_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/holdings_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/portfolio_empty_body"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/portfolio_add_transaction"
        style="@style/Widget.Crypto.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/portfolio_add_transaction"
        app:icon="@drawable/ic_portfolio_add"
        app:iconGravity="textStart" />

</LinearLayout>
