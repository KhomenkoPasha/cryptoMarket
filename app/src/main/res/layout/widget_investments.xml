<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_investments_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_investments_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_investments_title"
            android:src="@drawable/ic_widget_investments" />

        <TextView
            android:id="@+id/widget_investments_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_investments_title"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_investments_open_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_investments_open"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/text_size_headline" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_investments_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_investments_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_investments_empty"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_investments_empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/widget_investments_empty_hint"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/text_size_label" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_investments_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_investments_current_value_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_investments_current_value"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/text_size_micro" />

        <TextView
            android:id="@+id/widget_investments_current_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_investments_zero_value"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_investments_invested_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_investments_invested"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/text_size_micro" />

                <TextView
                    android:id="@+id/widget_investments_invested_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/widget_investments_zero_value"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/text_size_label"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_investments_total_return_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_investments_total_return"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/text_size_micro" />

                <TextView
                    android:id="@+id/widget_investments_pnl_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:text="@string/widget_investments_zero_return"
                    android:textColor="@color/positive"
                    android:textSize="@dimen/text_size_label"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_investments_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/widget_investments_positions_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_investments_positions"
            android:textColor="@color/secondary_text"
            android:textSize="@dimen/text_size_micro"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_investment_row_1"
            style="@style/WidgetInvestmentRow">

            <TextView
                android:id="@+id/widget_investment_symbol_1"
                style="@style/WidgetInvestmentSymbol" />

            <TextView
                android:id="@+id/widget_investment_value_1"
                style="@style/WidgetInvestmentValue" />

            <TextView
                android:id="@+id/widget_investment_allocation_1"
                style="@style/WidgetInvestmentAllocation" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_investment_row_2"
            style="@style/WidgetInvestmentRow">

            <TextView
                android:id="@+id/widget_investment_symbol_2"
                style="@style/WidgetInvestmentSymbol" />

            <TextView
                android:id="@+id/widget_investment_value_2"
                style="@style/WidgetInvestmentValue" />

            <TextView
                android:id="@+id/widget_investment_allocation_2"
                style="@style/WidgetInvestmentAllocation" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_investment_row_3"
            style="@style/WidgetInvestmentRow">

            <TextView
                android:id="@+id/widget_investment_symbol_3"
                style="@style/WidgetInvestmentSymbol" />

            <TextView
                android:id="@+id/widget_investment_value_3"
                style="@style/WidgetInvestmentValue" />

            <TextView
                android:id="@+id/widget_investment_allocation_3"
                style="@style/WidgetInvestmentAllocation" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
