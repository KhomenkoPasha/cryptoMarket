<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/portfolio_name_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/portfolio_name_hint"
        app:counterEnabled="true"
        app:counterMaxLength="32"
        app:errorTextAppearance="@style/TextAppearance.Crypto.TextInput.Error"
        app:hintTextAppearance="@style/TextAppearance.Crypto.TextInput.Hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/portfolio_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLength="32"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_size_title" />

    </com.google.android.material.textfield.TextInputLayout>

</FrameLayout>
