<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/news_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/glass_surface_start"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/glass_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/news_item_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_surface"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="CoinDesk" />

            <TextView
                android:id="@+id/news_item_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                tools:text="09 Aug 2026 · 14:30" />

        </LinearLayout>

        <TextView
            android:id="@+id/news_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/on_surface"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="Bitcoin market gains momentum as institutional demand grows" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/news_item_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Crypto.NewsImage"
            tools:src="@drawable/splash_screen_img"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/news_item_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            tools:text="The latest market update and the most important details for crypto investors." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/news_item_open"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:text="@string/news_read_article"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            app:icon="@drawable/ic_open_in_new"
            app:iconGravity="textEnd"
            app:iconTint="@color/brand_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
