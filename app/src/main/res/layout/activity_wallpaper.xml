<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_depth"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:minHeight="48dp"
            android:theme="@style/ToolbarColoredBackArrow"
            app:titleTextAppearance="@style/TextAppearance.Crypto.Toolbar"
            app:titleTextColor="@color/on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="16dp"
                android:text="@string/wallpaper_description"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/wallpaper_gallery"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/wallpaper_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:useDefaultMargins="false" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_container"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="@string/wallpaper_appearance"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wallpaper_transparency_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/wallpaper_transparency"
                        android:text="@string/wallpaper_transparency_label"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/wallpaper_transparency"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:stepSize="5"
                        android:valueFrom="0"
                        android:valueTo="70" />

                    <TextView
                        android:id="@+id/wallpaper_dimming_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:labelFor="@id/wallpaper_dimming"
                        android:text="@string/wallpaper_dimming_label"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_size_body" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/wallpaper_dimming"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:stepSize="5"
                        android:valueFrom="0"
                        android:valueTo="80" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/wallpaper_readability"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
