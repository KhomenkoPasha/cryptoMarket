<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/csv_import_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_size_body_large"
        tools:text="Found 120 transactions (Binance). 3 rows were skipped." />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/csv_import_target_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/csv_import_target"
        android:visibility="gone"
        app:hintTextAppearance="@style/TextAppearance.Crypto.TextInput.Hint">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/csv_import_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_size_title" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
