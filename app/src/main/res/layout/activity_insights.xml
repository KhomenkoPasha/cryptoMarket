<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_depth"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_appbar_glass"
            android:minHeight="48dp"
            android:theme="@style/ToolbarColoredBackArrow"
            app:titleTextAppearance="@style/TextAppearance.Crypto.Toolbar"
            app:titleTextColor="@color/on_surface" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/insights_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/insights_updated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/secondary_text"
                    android:textSize="@dimen/text_size_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/insights_refresh"
                    style="@style/Widget.Crypto.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/refresh" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/market_mood_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/digest_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/alerts_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/watchlist_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/compare_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/anomalies_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/categories_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/news_impact_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/beginner_container"
                style="@style/InsightsSection" />

            <LinearLayout
                android:id="@+id/glossary_container"
                style="@style/InsightsSection" />

            </LinearLayout>
        </ScrollView>

        <com.github.ybq.android.spinkit.SpinKitView
            android:id="@+id/insights_loading_indicator"
            style="@style/SpinKitView.Large.Circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/loading"
            android:visibility="gone"
            app:SpinKit_Color="@color/accent" />

    </FrameLayout>
</LinearLayout>
