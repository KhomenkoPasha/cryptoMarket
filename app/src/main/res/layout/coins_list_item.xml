<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_surface"
    android:elevation="2dp"
    android:minHeight="88dp"
    android:padding="16dp">

    <ImageView
        android:id="@+id/main_item_market_logo"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/main_item_full_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/main_item_from" />

    <TextView
        android:id="@+id/main_item_from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="@color/on_surface"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintLeft_toRightOf="@+id/main_item_market_logo"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="BTC" />

    <TextView
        android:id="@+id/main_item_to"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/on_surface_variant"
        android:textSize="18sp"
        app:layout_constraintLeft_toRightOf="@+id/main_item_from"
        app:layout_constraintTop_toTopOf="@+id/main_item_from"
        tools:text="USD" />

    <TextView
        android:id="@+id/main_item_full_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintLeft_toLeftOf="@+id/main_item_from"
        app:layout_constraintTop_toBottomOf="@+id/main_item_from"
        tools:text="Bitcoin" />

    <TextView
        android:id="@+id/main_item_holding_qty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/main_item_from"
        tools:text="3.22" />

    <TextView
        android:id="@+id/main_item_holding_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintLeft_toLeftOf="@+id/main_item_holding_qty"
        app:layout_constraintTop_toBottomOf="@+id/main_item_holding_qty"
        tools:text="$45697" />

    <TextView
        android:id="@+id/main_item_last_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/brand_primary"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/main_item_price_arrow"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2542" />

    <ImageView
        android:id="@+id/main_item_price_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_constraintEnd_toStartOf="@+id/main_item_remove_favorite"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_arrow_drop_up_green" />

    <TextView
        android:id="@+id/main_item_change_in_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant"
        app:layout_constraintEnd_toStartOf="@+id/main_item_remove_favorite"
        app:layout_constraintTop_toBottomOf="@+id/main_item_last_price"
        tools:text="+101%" />

    <ImageButton
        android:id="@+id/main_item_remove_favorite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_coin"
        android:padding="10dp"
        android:src="@drawable/ic_remove_favorite"
        android:tooltipText="@string/remove_coin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/on_surface_variant" />
</androidx.constraintlayout.widget.ConstraintLayout>
