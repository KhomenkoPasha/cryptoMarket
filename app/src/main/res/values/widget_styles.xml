<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetInvestmentRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="WidgetInvestmentSymbol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">BTC</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">@dimen/text_size_label</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetInvestmentValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">$0.00</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">@dimen/text_size_label</item>
    </style>

    <style name="WidgetInvestmentAllocation">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">0%</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/text_size_micro</item>
    </style>
</resources>
