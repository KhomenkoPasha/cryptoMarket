<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_brand_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/app_background</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/app_background</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="colorSurface">@color/surface_container_low</item>
        <item name="colorSurfaceVariant">@color/surface_container_high</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/negative</item>
        <item name="colorOnError">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="colorControlNormal">@color/on_surface_variant</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Crypto.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Crypto.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Crypto.Large</item>
    </style>

    <style name="ToolbarColoredBackArrow" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="android:textColorSecondary">@color/on_surface</item>
        <item name="colorControlNormal">@color/on_surface</item>
    </style>

    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">240</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppTheme.NoActionBar_dialog" parent="Theme.Material3Expressive.Dark.Dialog">
        <item name="windowActionBar">false</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:windowBackground">@color/surface_container</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="EditTextBaseStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:background">@drawable/bg_input_surface</item>
        <item name="android:padding">16dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MyRadioButton" >
        <item name="android:textSize">18sp</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="InsightsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card_surface</item>
        <item name="android:elevation">3dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="ShapeAppearance.Crypto.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Crypto.Medium" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Crypto.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
