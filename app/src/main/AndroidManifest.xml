<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.khom.pavlo.crypto">

    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <activity
            android:name=".ui.main.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.addCoin.AddCoinActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity
            android:name=".ui.coinInfo.CoinInfoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity
            android:name=".ui.coinAllocation.CoinAllocationActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity
            android:name=".ui.holdings.HoldingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <receiver
            android:name=".widget.FavoritesWidgetSmallProvider"
            android:exported="false"
            android:label="@string/widget_favorites_title_small"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorites_widget_small" />
        </receiver>

        <receiver
            android:name=".widget.FavoritesWidgetLargeProvider"
            android:exported="false"
            android:label="@string/widget_favorites_title_large"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorites_widget_large" />
        </receiver>
    </application>

</manifest>
